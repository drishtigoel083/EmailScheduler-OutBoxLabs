{
  "name": "email-scheduler-backend",
  "version": "1.0.0",
  "description": "Production-grade Email Scheduler Backend with BullMQ, Redis, Postgres, and Ethereal Email",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
